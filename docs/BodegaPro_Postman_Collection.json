{
  "info": {
    "name": "BodegaPro - Backend",
    "description": "1) Ejecuta 'Login admin' (guarda el token solo). 2) Ejecuta cualquier otra peticion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "variable": [{ "key": "base", "value": "http://localhost:8080" }, { "key": "token", "value": "" }],
  "item": [
    { "name": "AUTH - Login admin",
      "event": [{ "listen": "test", "script": { "type": "text/javascript",
        "exec": ["pm.collectionVariables.set('token', pm.response.json().token);"] } }],
      "request": { "auth": { "type": "noauth" }, "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}" },
        "url": "{{base}}/auth/login" } },
    { "name": "AUTH - Login vendedor",
      "event": [{ "listen": "test", "script": { "type": "text/javascript",
        "exec": ["pm.collectionVariables.set('token', pm.response.json().token);"] } }],
      "request": { "auth": { "type": "noauth" }, "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"vendedor\",\n  \"password\": \"vendedor123\"\n}" },
        "url": "{{base}}/auth/login" } },
    { "name": "AUTH - Login con password incorrecto (401)",
      "request": { "auth": { "type": "noauth" }, "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"mal\"\n}" },
        "url": "{{base}}/auth/login" } },
    { "name": "AUTH - Login con campos vacios (400)",
      "request": { "auth": { "type": "noauth" }, "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"\",\n  \"password\": \"\"\n}" },
        "url": "{{base}}/auth/login" } },
    { "name": "AUTH - Registrar usuario",
      "request": { "auth": { "type": "noauth" }, "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Maria Lopez\",\n  \"username\": \"maria\",\n  \"email\": \"maria@demo.com\",\n  \"password\": \"secret123\"\n}" },
        "url": "{{base}}/auth/register" } },

    { "name": "CATEGORIAS - GET listar", "request": { "method": "GET", "url": "{{base}}/categorias" } },
    { "name": "CATEGORIAS - GET por id", "request": { "method": "GET", "url": "{{base}}/categorias/1" } },
    { "name": "CATEGORIAS - POST crear",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Congelados\",\n  \"descripcion\": \"Helados y productos refrigerados\"\n}" },
        "url": "{{base}}/categorias" } },
    { "name": "CATEGORIAS - PUT actualizar",
      "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Snacks y golosinas\",\n  \"descripcion\": \"Galletas, piqueos y dulces\"\n}" },
        "url": "{{base}}/categorias/5" } },
    { "name": "CATEGORIAS - DELETE (solo ADMIN)", "request": { "method": "DELETE", "url": "{{base}}/categorias/6" } },

    { "name": "PROVEEDORES - GET listar", "request": { "method": "GET", "url": "{{base}}/proveedores" } },
    { "name": "PROVEEDORES - POST crear",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"razonSocial\": \"Comercial Norte S.R.L.\",\n  \"ruc\": \"20555666777\",\n  \"telefono\": \"044123456\",\n  \"email\": \"ventas@comercialnorte.pe\"\n}" },
        "url": "{{base}}/proveedores" } },
    { "name": "PROVEEDORES - POST RUC invalido (400)",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"razonSocial\": \"Proveedor X\",\n  \"ruc\": \"123\"\n}" },
        "url": "{{base}}/proveedores" } },
    { "name": "PROVEEDORES - PUT actualizar",
      "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"razonSocial\": \"Distribuidora Andina S.A.C.\",\n  \"ruc\": \"20512345678\",\n  \"telefono\": \"019998877\",\n  \"email\": \"ventas@andina.pe\"\n}" },
        "url": "{{base}}/proveedores/1" } },
    { "name": "PROVEEDORES - DELETE (solo ADMIN)", "request": { "method": "DELETE", "url": "{{base}}/proveedores/4" } },

    { "name": "PRODUCTOS - GET listar", "request": { "method": "GET", "url": "{{base}}/productos" } },
    { "name": "PRODUCTOS - GET por id", "request": { "method": "GET", "url": "{{base}}/productos/1" } },
    { "name": "PRODUCTOS - POST crear",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"ABR-010\",\n  \"nombre\": \"Fideos spaghetti 500 g\",\n  \"descripcion\": \"Fideos de trigo\",\n  \"precioCompra\": 2.10,\n  \"precioVenta\": 3.00,\n  \"stockInicial\": 50,\n  \"stockMinimo\": 15,\n  \"fechaVencimiento\": \"2027-06-30\",\n  \"categoriaId\": 1,\n  \"proveedorId\": 1\n}" },
        "url": "{{base}}/productos" } },
    { "name": "PRODUCTOS - POST precio venta menor a compra (400)",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"ABR-011\",\n  \"nombre\": \"Producto con error\",\n  \"precioCompra\": 10.00,\n  \"precioVenta\": 8.00,\n  \"stockMinimo\": 5,\n  \"categoriaId\": 1\n}" },
        "url": "{{base}}/productos" } },
    { "name": "PRODUCTOS - PUT actualizar",
      "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"ABR-001\",\n  \"nombre\": \"Arroz extra 5 kg\",\n  \"precioCompra\": 19.00,\n  \"precioVenta\": 23.00,\n  \"stockMinimo\": 12,\n  \"categoriaId\": 1,\n  \"proveedorId\": 1\n}" },
        "url": "{{base}}/productos/1" } },
    { "name": "PRODUCTOS - DELETE (solo ADMIN)", "request": { "method": "DELETE", "url": "{{base}}/productos/9" } },

    { "name": "MOVIMIENTOS - POST entrada",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"productoId\": 2,\n  \"tipo\": \"ENTRADA\",\n  \"cantidad\": 30,\n  \"motivo\": \"Compra a proveedor\"\n}" },
        "url": "{{base}}/movimientos" } },
    { "name": "MOVIMIENTOS - POST salida",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"productoId\": 1,\n  \"tipo\": \"SALIDA\",\n  \"cantidad\": 5,\n  \"motivo\": \"Venta del dia\"\n}" },
        "url": "{{base}}/movimientos" } },
    { "name": "MOVIMIENTOS - POST salida con stock insuficiente (409)",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"productoId\": 5,\n  \"tipo\": \"SALIDA\",\n  \"cantidad\": 999\n}" },
        "url": "{{base}}/movimientos" } },
    { "name": "MOVIMIENTOS - GET historial", "request": { "method": "GET", "url": "{{base}}/movimientos" } },
    { "name": "DASHBOARD - GET resumen", "request": { "method": "GET", "url": "{{base}}/dashboard" } }
  ]
}
